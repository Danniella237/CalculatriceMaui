<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculatriceMaui.MainPage"
             BackgroundColor="#17171C">

    <!-- Layout 1: ScrollView pour s'assurer que tout reste visible sur petit écran -->
    <ScrollView Padding="15">

        <!-- Layout 2: VerticalStackLayout pour organiser l'écran et le clavier -->
        <VerticalStackLayout Spacing="15">

            <!-- Layout 3: Border pour encadrer la zone d'affichage du calcul -->
            <Border Stroke="#2E2E38"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 16"
                    BackgroundColor="#2E2E38"
                    Padding="15"
                    Margin="0,10,0,10">

                <VerticalStackLayout Spacing="5">
                    <!-- Opération en cours (ex: 12 + 5) -->
                    <Label x:Name="CurrentOperationLabel"
                           Text=""
                           FontSize="18"
                           TextColor="#8E8E93"
                           HorizontalTextAlignment="End"/>

                    <!-- Résultat principal -->
                    <Label x:Name="ResultLabel"
                           Text="0"
                           FontSize="44"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="End"/>
                </VerticalStackLayout>
            </Border>

            <!-- Layout 4: Grid pour le pavé numérique et les touches de fonction -->
            <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto"
                  ColumnDefinitions="*, *, *, *"
                  RowSpacing="10"
                  ColumnSpacing="10">

                <!-- Ligne 1 : Contrôles -->
                <Button Text="C" Grid.Row="0" Grid.Column="0" Clicked="OnClearClicked" BackgroundColor="#616161" TextColor="White" FontSize="20" CornerRadius="12"/>
                <Button Text="⌫" Grid.Row="0" Grid.Column="1" Clicked="OnBackspaceClicked" BackgroundColor="#616161" TextColor="White" FontSize="20" CornerRadius="12"/>
                <Button Text="+/-" Grid.Row="0" Grid.Column="2" Clicked="OnToggleSignClicked" BackgroundColor="#616161" TextColor="White" FontSize="20" CornerRadius="12"/>
                <Button Text="÷" Grid.Row="0" Grid.Column="3" Clicked="OnOperationClicked" BackgroundColor="#4B5EAA" TextColor="White" FontSize="22" CornerRadius="12"/>

                <!-- Ligne 2 : 7, 8, 9, x -->
                <Button Text="7" Grid.Row="1" Grid.Column="0" Clicked="OnNumberClicked" BackgroundColor="#2E2E38" TextColor="White" FontSize="20" CornerRadius="12"/>
                <Button Text="8" Grid.Row="1" Grid.Column="1" Clicked="OnNumberClicked" BackgroundColor="#2E2E38" TextColor="White" FontSize="20" CornerRadius="12"/>
                <Button Text="9" Grid.Row="1" Grid.Column="2" Clicked="OnNumberClicked" BackgroundColor="#2E2E38" TextColor="White" FontSize="20" CornerRadius="12"/>
                <Button Text="×" Grid.Row="1" Grid.Column="3" Clicked="OnOperationClicked" BackgroundColor="#4B5EAA" TextColor="White" FontSize="22" CornerRadius="12"/>

                <!-- Ligne 3 : 4, 5, 6, - -->
                <Button Text="4" Grid.Row="2" Grid.Column="0" Clicked="OnNumberClicked" BackgroundColor="#2E2E38" TextColor="White" FontSize="20" CornerRadius="12"/>
                <Button Text="5" Grid.Row="2" Grid.Column="1" Clicked="OnNumberClicked" BackgroundColor="#2E2E38" TextColor="White" FontSize="20" CornerRadius="12"/>
                <Button Text="6" Grid.Row="2" Grid.Column="2" Clicked="OnNumberClicked" BackgroundColor="#2E2E38" TextColor="White" FontSize="20" CornerRadius="12"/>
                <Button Text="-" Grid.Row="2" Grid.Column="3" Clicked="OnOperationClicked" BackgroundColor="#4B5EAA" TextColor="White" FontSize="22" CornerRadius="12"/>

                <!-- Ligne 4 : 1, 2, 3, + -->
                <Button Text="1" Grid.Row="3" Grid.Column="0" Clicked="OnNumberClicked" BackgroundColor="#2E2E38" TextColor="White" FontSize="20" CornerRadius="12"/>
                <Button Text="2" Grid.Row="3" Grid.Column="1" Clicked="OnNumberClicked" BackgroundColor="#2E2E38" TextColor="White" FontSize="20" CornerRadius="12"/>
                <Button Text="3" Grid.Row="3" Grid.Column="2" Clicked="OnNumberClicked" BackgroundColor="#2E2E38" TextColor="White" FontSize="20" CornerRadius="12"/>
                <Button Text="+" Grid.Row="3" Grid.Column="3" Clicked="OnOperationClicked" BackgroundColor="#4B5EAA" TextColor="White" FontSize="22" CornerRadius="12"/>

                <!-- Ligne 5 : %, 0, ., = -->
                <Button Text="%" Grid.Row="4" Grid.Column="0" Clicked="OnPercentageClicked" BackgroundColor="#2E2E38" TextColor="White" FontSize="20" CornerRadius="12"/>
                <Button Text="0" Grid.Row="4" Grid.Column="1" Clicked="OnNumberClicked" BackgroundColor="#2E2E38" TextColor="White" FontSize="20" CornerRadius="12"/>
                <Button Text="," Grid.Row="4" Grid.Column="2" Clicked="OnDecimalClicked" BackgroundColor="#2E2E38" TextColor="White" FontSize="20" CornerRadius="12"/>
                <Button Text="=" Grid.Row="4" Grid.Column="3" Clicked="OnCalculateClicked" BackgroundColor="#4B5EAA" TextColor="White" FontSize="22" CornerRadius="12"/>

            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>